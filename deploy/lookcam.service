[Unit]
Description=LookCam service (PPPP + web + RTSP bridge)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The repository root is installed at /opt/lookcam; no nested package directory.
WorkingDirectory=/opt/lookcam
# Create and own the cache and log directories automatically.
StateDirectory=lookcam
LogsDirectory=lookcam
ExecStart=/usr/bin/python3 -m service \
    --config /opt/lookcam/config/lookcam_service.json \
    --cache-dir /var/lib/lookcam \
    --log-file /var/log/lookcam/service.log
Restart=on-failure
RestartSec=5
User=lookcam
Group=lookcam
# PPPP listens on UDP 32108, HTTP on 8080, RTSP on 8554.
AmbientCapabilities=
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lookcam /var/log/lookcam /opt/lookcam/config
# If the cache and config live elsewhere, add them to ReadWritePaths.
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
